# ── LLM 配置 ──────────────────────────────────────────────
XIAOMI_API_KEY=tp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XIAOMI_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2.5-pro

MINIMAX_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_API_BASE=https://api.minimax.chat/v1
MINIMAX_TEXT_MODEL=MiniMax-M2.7
MINIMAX_IMAGE_MODEL=image-01
# MiniMax Token Plan 内置联网搜索 (450次/日免费)
MINIMAX_SEARCH_HOST=https://api.minimaxi.com

# ── 第 1 层: LLM 联网搜索 ─────────────────────────────────
# 腾讯混元 (校园赛加分项, 注册: cloud.tencent.com)
# HUNYUAN_API_KEY=
# HUNYUAN_API_BASE=https://api.hunyuan.cloud.tencent.com/v1
# HUNYUAN_MODEL=hunyuan-turbos-latest

# 阿里千问 (注册: dashscope.aliyun.com)
# QWEN_API_KEY=
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# ── 第 2 层: 搜索 API (需注册免费 Key) ────────────────────
# Serper (Google SERP, 2500 免费/月, 注册: serper.dev)
# SERPER_API_KEY=

# Tavily (AI 优化搜索, 1000 免费/月, 注册: tavily.com)
# TAVILY_API_KEY=

# Exa (语义搜索, $10 免费, 注册: exa.ai)
# EXA_API_KEY=

# Brave Search ($5 免费额度, 注册: api.search.brave.com)
# BRAVE_API_KEY=

# You.com ($100 免费额度, 注册: you.com/platform)
# YOU_API_KEY=

# ── 第 6 层: SearXNG (可选, 无需 Key) ────────────────────
# 自建实例 URL 或留空使用公共实例
# SEARXNG_URL=

# ── 第 7 层: Jina AI (10M tokens/月免费) ─────────────────
# JINA_API_KEY=

# ── 热搜聚合 ──────────────────────────────────────────────
# DailyHotApi (默认公共实例, 可自建)
# DAILYHOT_API_BASE=https://hot.imsyy.top
